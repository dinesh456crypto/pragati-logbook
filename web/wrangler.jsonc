// Cloudflare deploy config (used if the project is created as a Worker with
// static assets). Serves the built React app and sends unknown paths to
// index.html so client-side routes like /jobs work on refresh.
{
  "name": "logbook",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
