// Cloudflare deploy config: a Worker with static assets.
//  * Serves the built React app; unknown paths get index.html so client-side
//    routes like /production/entry work on refresh.
//  * /supabase/* is forwarded to the Supabase project by worker/index.js
//    (some internet providers block *.supabase.co).
{
  "name": "logbook",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/supabase/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://mklkjywrtypdyqovqhvw.supabase.co"
  }
}
